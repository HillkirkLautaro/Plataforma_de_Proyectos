{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/schemas/habilidad.schema.json",
  "title": "Habilidad de usuario",
  "description": "Relación entre un usuario y una tecnología o lenguaje del catálogo externo.",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": ["tecnologia", "lenguaje"]
    },
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "nivel": {
      "type": "string",
      "enum": ["básico", "intermedio", "avanzado"]
    }
  },
  "required": ["tipo", "id", "nivel"],
  "additionalProperties": false
}
