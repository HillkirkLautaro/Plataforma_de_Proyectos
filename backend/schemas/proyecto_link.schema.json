{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/schemas/proyecto_link.schema.json",
  "title": "Enlace de proyecto",
  "description": "Enlace aceptado por la ruta de proyectos.",
  "type": "object",
  "properties": {
    "tipo": {"type": "string", "enum": ["demo", "github", "gitlab"]},
    "url": {
      "type": "string",
      "maxLength": 255,
      "format": "uri",
      "pattern": "^https?://(?![^/?#]*@)[^/?#\\s]+[^\\s]*$"
    }
  },
  "required": ["tipo", "url"],
  "additionalProperties": false
}
